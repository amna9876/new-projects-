# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# Nothing in Phase 1 (contract + mock store) needs a secret; the AI key is
# first used by the chat server.

# --- AI provider (used by packages/server) ----------------------------------
# Which Vercel AI SDK provider to use. Supported: anthropic (default).
AI_PROVIDER=anthropic
# Model id passed to the provider. Never hardcoded in the source.
AI_MODEL=
# API key for the chosen provider. For AI_PROVIDER=anthropic:
ANTHROPIC_API_KEY=

# --- Store API ---------------------------------------------------------------
# Base URL of a store that implements the Store API contract.
# The bundled mock store listens on http://localhost:4000.
STORE_API_BASE_URL=http://localhost:4000
# Optional. Sent as `Authorization: Bearer <key>`. When set, the mock store
# also requires it on every request.
STORE_API_KEY=

# --- Chat server -------------------------------------------------------------
# Comma-separated list of origins allowed to call the chat endpoint (CORS).
ALLOWED_ORIGINS=http://localhost:3000
# Maximum chat requests per minute, enforced per IP and per session.
RATE_LIMIT_PER_MINUTE=20
