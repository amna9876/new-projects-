# Copy this file to `.env` in the repository root and fill in the values.
# `.env` is git-ignored. Never commit real keys.
#
# Only two values are required to run the demo: AI_MODEL and your provider's key
# (or no key at all with AI_PROVIDER=ollama).
# Everything else has a working default for local development.

# --- AI provider (packages/server) -------------------------------------------
# Which model provider to use. Set ONE provider and the key that belongs to it.
#   anthropic  Claude models.            Key: ANTHROPIC_API_KEY
#   google     Gemini models.            Key: GOOGLE_GENERATIVE_AI_API_KEY
#   groq       Open models, hosted.      Key: GROQ_API_KEY
#   ollama     A model on your own PC.   No key. Install Ollama and pull a model first.
# Google and Groq have offered free tiers with rate limits; check their current terms.
AI_PROVIDER=anthropic
# REQUIRED. Model id for the chosen provider, copied from that provider's
# documentation. It must support tool calling. Never hardcoded in the source.
AI_MODEL=
# The key for the provider you chose. Leave the others empty.
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
# Optional, ollama only. Where your Ollama server listens.
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Store API ---------------------------------------------------------------
# Base URL of a store that implements the Store API contract.
# The bundled mock store listens on http://localhost:4000.
STORE_API_BASE_URL=http://localhost:4000
# Optional. Sent as `Authorization: Bearer <key>`. When set, the mock store
# also requires it on every request.
STORE_API_KEY=

# --- Chat server -------------------------------------------------------------
# Comma-separated list of exact origins allowed to call the chat API from a
# browser (CORS). A wildcard (*) is rejected.
ALLOWED_ORIGINS=http://localhost:3000
# Maximum requests per minute, enforced separately per client IP and per chat session.
RATE_LIMIT_PER_MINUTE=20
# Optional. Port the chat server listens on.
PORT=3001
# Optional. Set to true ONLY when the server sits behind a reverse proxy you
# control that sets X-Forwarded-For. When false, that header is ignored, so
# clients cannot dodge the per-IP limit by faking it.
TRUST_PROXY=false
# Optional. Store name used in the assistant's instructions.
STORE_NAME=
